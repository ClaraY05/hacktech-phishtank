{
  "manifest_version": 3,
  "name": "PhishTank",
  "version": "0.1.0",
  "description": "Scaffold extension for safe link analysis.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "dist/background/index.js"
  },
  "icons": {
    "16": "src/fih_icons/fih_icon.png",
    "32": "src/fih_icons/fih_icon.png",
    "48": "src/fih_icons/fih_icon.png",
    "128": "src/fih_icons/fih_icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/styles/index.css",
        "src/content/styles/tokens.css",
        "src/content/styles/link-highlight.css",
        "src/content/styles/tooltip.css",
        "src/content/styles/badge.css",
        "src/content/styles/warning-modal.css",
        "src/popup/popup.html",
        "dist/popup/index.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "PhishTank",
    "default_icon": {
      "16": "src/fih_icons/fih_icon.png",
      "32": "src/fih_icons/fih_icon.png",
      "48": "src/fih_icons/fih_icon.png",
      "128": "src/fih_icons/fih_icon.png"
    }
  }
}
