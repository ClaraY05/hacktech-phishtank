{
  "manifest_version": 3,
  "name": "AI Safe Link Sandbox",
  "version": "0.1.0",
  "description": "Scaffold extension for safe link analysis.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AI Safe Link",
    "default_popup": "src/popup/popup.html"
  }
}
