{
  "manifest_version": 3,
  "name": "AI Safe Link Sandbox",
  "version": "0.1.0",
  "description": "Scaffold extension for safe link analysis.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "background": {
    "service_worker": "dist/background/index.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/helper/styles.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "AI Safe Link",
    "default_popup": "src/popup/popup.html"
  }
}
