# Backend environment
K2_API_KEY=your_k2_api_key_here
K2_BASE_URL=https://api.k2think.ai
K2_MODEL=MBZUAI-IFM/K2-Think-v2

# Gemma 4 (Google AI Studio / Gemini API)
# Available Gemma 4 model IDs on the Gemini API:
#   gemma-4-26b-a4b-it  (MoE, default)
#   gemma-4-31b-it      (dense "Effective" variant)
GEMINI_API_KEY=your_gemini_api_key_here
GEMMA_BASE_URL=https://generativelanguage.googleapis.com
GEMMA_MODEL=gemma-4-26b-a4b-it

# Sandbox backend selection. The pipeline only depends on the backend
# protocol, so swapping in/out of containers requires no code changes.
#   inprocess  - call sandbox.capture() directly (default; no host isolation)
#   docker     - run safe-link-worker image per request (host isolation)
SANDBOX_BACKEND=inprocess

# Docker backend tunables (only read when SANDBOX_BACKEND=docker).
# SANDBOX_IMAGE matches the tag produced by `docker build -t safe-link-worker backend/`.
# USE_RUNSC defaults off; flip to 1 once setup.sh has registered runsc
# in /etc/docker/daemon.json.
SANDBOX_IMAGE=safe-link-worker
USE_RUNSC=0
SANDBOX_TIMEOUT_S=30
# DOCKER_PATH=/usr/local/bin/docker
# SANDBOX_NETWORK=sandbox-egress      # restrictive bridge net (no LAN access)
# SANDBOX_MEMORY=1g
# SANDBOX_CPUS=1.0
# SANDBOX_PIDS_LIMIT=200
# SANDBOX_TMPFS_SIZE=200m

# Verdict cache (in-process; swap for Redis behind AnalysisCache to share
# across uvicorn workers). The browser extension fires /analyze-link on
# every hover, so caching is essential for usable latency.
ANALYSIS_CACHE_MAX=10000
ANALYSIS_CACHE_TTL_S=3600
